  "detailed_description": "Photorealistic wuxia action film shot on a cinema camera: rainy night, cold blue grade with warm lantern accents, heavy rain and splashing water, fast practical sword fighting with clear contact.\n\n[Shot 1] Shot (00:00.000 - 00:00.500).\n\n[Shot 2] Shot (00:00.500 - 00:01.733).\n\n[Shot 3] Shot (00:01.733 - 00:02.600).\n\n[Shot 4] Shot (00:02.600 - 00:02.900).\n\n[Shot 5] Shot (00:02.900 - 00:03.000).\n\n[Shot 6] Shot (00:03.000 - 00:03.300).\n\n[Shot 7] Shot (00:03.300 - 00:05.000).\n\n[Shot 8] Shot (00:05.000 - 00:05.167).\n\n[Shot 9] Shot (00:05.167 - 00:05.967).\n\n[Shot 10] Shot (00:05.967 - 00:06.133).\n\n[Shot 11] Shot (00:06.133 - 00:08.000).\n\nNo text, captions, logos or watermarks appear in the picture.",
  "overall_soundscape": "Heavy rain, splashing footsteps, clashing blades and grunts.",
  "non_diegetic_music": "N/A"
}</text:Value>
  <h3:ReferenceVideo id="g-s08" prompt={p-s08} duration="8" aspect-ratio="16:9">
    <h3:Reference image={cast-hero}/>
    <h3:Reference image={cast-hero_full}/>
    <h3:Reference image={cast-boss}/>
    <h3:Reference image={cast-henchmen}/>
    <h3:Reference image={cast-scene}/>
  </h3:ReferenceVideo>
  <pipeline:Normalize id="gm-s08" source={g-s08.video} clock={clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Transform id="cut-s08" source={gm-s08.media}>
    <pipeline:Trim end="7.6667s"/>
  </pipeline:Transform>
  <pipeline:Normalize id="m-s08" source={cut-s08.video} clock={clock} video="primary-moving" audio="none" span-authority="video"/>
  <whisperx:SemanticTake id="t-s08" narrative={story} segment={story.segment.s08} media={m-s08.media}/>

  <!-- ===== s09 · 原片 2317–2573 帧（8.53 秒，2 镜）· h3-reference ===== -->
  <text:Value id="p-s09">{
  "subject_definitions": [
    "&lt;Subject 1&gt; is the person in &lt;Picture 1&gt;: the man with a tight topknot, a few wet strands over his forehead, an old scar across his brow bone and a dark indigo, near-black robe with subtle tone-on-tone embroidery.",
    "&lt;Picture 2&gt; shows the same man's full-length costume: near-black robe, leather belt and a long sword in a dark scabbard at his waist.",
    "&lt;Subject 2&gt; are the group in &lt;Picture 3&gt;: the swordsmen in low black woven bamboo hats hiding their eyes, soaked black robes and leather belts, each holding a long sabre.",
    "&lt;Picture 4&gt; shows the location: an ancient courtyard on a rainy night, dark timber corridors and pillars, grey-tiled eaves pouring water, wet reflective stone paving and dim warm lanterns in a cold blue night."
  ],
  "summary": "[reference generation] A 9-second sequence of 2 shots.",
  "retention_analysis": [
    "&lt;Subject 1&gt;: fully_preserved - face, hairstyle and costume are retained.",
    "&lt;Subject 2&gt;: fully_preserved - look, costume and weapons are retained."
  ],
  "detailed_description": "Photorealistic wuxia action film shot on a cinema camera: rainy night, cold blue grade with warm lantern accents, heavy rain and splashing water, fast practical sword fighting with clear contact.\n\n[Shot 1] Shot (00:00.000 - 00:00.867).\n\n[Shot 2] Shot (00:00.867 - 00:09.000).\n\nNo text, captions, logos or watermarks appear in the picture.",
  "overall_soundscape": "Heavy rain, splashing footsteps, clashing blades and grunts.",
  "non_diegetic_music": "N/A"
}</text:Value>
  <h3:ReferenceVideo id="g-s09" prompt={p-s09} duration="9" aspect-ratio="16:9">
    <h3:Reference image={cast-hero}/>
    <h3:Reference image={cast-hero_full}/>
    <h3:Reference image={cast-henchmen}/>
    <h3:Reference image={cast-scene}/>
  </h3:ReferenceVideo>
  <pipeline:Normalize id="gm-s09" source={g-s09.video} clock={clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Transform id="cut-s09" source={gm-s09.media}>
    <pipeline:Trim end="8.5333s"/>
  </pipeline:Transform>
  <pipeline:Normalize id="m-s09" source={cut-s09.video} clock={clock} video="primary-moving" audio="none" span-authority="video"/>
  <whisperx:SemanticTake id="t-s09" narrative={story} segment={story.segment.s09} media={m-s09.media}/>

  <!-- 每段放回它在原片里的位置（帧），整片长度与原片复刻区间一致。 -->
  <time:Timeline id="program" clock={clock} end="2573f">
    <time:Take source={t-s01.take} at="0f"/>
    <time:Take source={t-s02.take} at="249f"/>
    <time:Take source={t-s03.take} at="596f"/>
    <time:Take source={t-s04.take} at="938f"/>
    <time:Take source={t-s05.take} at="1333f"/>
    <time:Take source={t-s06.take} at="1730f"/>
    <time:Take source={t-s07.take} at="1927f"/>
    <time:Take source={t-s08.take} at="2087f"/>
    <time:Take source={t-s09.take} at="2317f"/>
  </time:Timeline>

  <space:Canvas id="canvas" width="1280" height="720"/>
  <space:Frame id="full" within={canvas} left="0px" top="0px" right="1280px" bottom="720px"/>
  <performance:Style id="shot-view" frame={full} appearance={recipes.media.shot}/>
  <performance:Track id="picture" timeline={program.timeline} canvas={canvas}>
    <performance:Use style={shot-view}/>
  </performance:Track>

  <!-- 声音：整段用参考片原声（音乐、音效、节奏都跟原切点对齐），生成画面静音。 -->
  <pipeline:Normalize id="source-audio" source={source} clock={clock} video="none" audio="default" span-authority="audio"/>
  <audio:Track id="soundtrack" timeline={program.timeline}>
    <audio:Item id="source-soundtrack" source={source-audio.media} during="program" playback="once-start"/>
  </audio:Track>

  <film:Film id="main" canvas={canvas} timeline={program.timeline} appearance={recipes.film.main}>
    <film:Track source={picture.visual}/>
    <film:Track source={soundtrack.audio}/>
  </film:Film>
  <render:Video id="final" composition={main.composition} timeline={program.timeline}/>
</svml>
